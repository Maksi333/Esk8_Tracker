<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Esk8_Tracker"
             x:Class="Esk8_Tracker.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <local:SegBgConverter x:Key="SegBgConverter" />
            <local:SegBorderConverter x:Key="SegBorderConverter" />
            <local:SegTextConverter x:Key="SegTextConverter" />
            <local:AccentTextConverter x:Key="AccentTextConverter" />
            <local:AutoBorderConverter x:Key="AutoBorderConverter" />
            <local:UnitSelBgConverter x:Key="UnitSelBgConverter" />
            <local:UnitSelTextConverter x:Key="UnitSelTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
