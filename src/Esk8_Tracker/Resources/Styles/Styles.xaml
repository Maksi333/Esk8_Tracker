<?xml version="1.0" encoding="UTF-8" ?>
<!-- ESK8 Tracker component styles. Dark-only theme per the design handoff:
     Chakra Petch = numerics/telemetry, Space Grotesk = display/headings, Inter = UI body. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ═════════ Page & implicit defaults ═════════ -->

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BgBase}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="Inter" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}" />
        <Setter Property="FontFamily" Value="SpaceGroteskSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource BorderDefault}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceCard}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource Accent}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource BorderDefault}" />
        <Setter Property="ThumbColor" Value="{StaticResource Accent}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Accent}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource BorderDefault}" />
    </Style>

    <!-- ═════════ Typography roles ═════════ -->

    <!-- Screen title: Space Grotesk 26/600, tight -->
    <Style x:Key="ScreenTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="SpaceGroteskSemiBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="CharacterSpacing" Value="-0.4" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Uppercase section label: Inter 11/600, letter-spacing, tertiary -->
    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
    </Style>

    <!-- Stat tile label: Inter 10.5/600 uppercase -->
    <Style x:Key="TileLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
    </Style>

    <!-- Telemetry value: Chakra Petch 26/600 (tabular digits baked into font) -->
    <Style x:Key="TileValue" TargetType="Label">
        <Setter Property="FontFamily" Value="ChakraPetchSemiBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="LineHeight" Value="1" />
    </Style>

    <!-- Small numeric caption (list stat lines): Chakra Petch, tertiary -->
    <Style x:Key="NumericCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="ChakraPetch" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
    </Style>

    <!-- Body copy: Inter 15, secondary -->
    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="LineHeight" Value="1.5" />
    </Style>

    <!-- Material Symbols icon -->
    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialRounded" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="IconFilled" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="FontFamily" Value="MaterialRoundedFilled" />
    </Style>

    <!-- ═════════ Containers ═════════ -->

    <!-- Standard card: surface + default border, 14–16 radius -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceCard}" />
        <Setter Property="Stroke" Value="{StaticResource BorderDefault}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Quieter secondary card -->
    <Style x:Key="CardQuiet" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceCard2}" />
    </Style>

    <!-- Inset well inside a card (graphs, thumbnails) -->
    <Style x:Key="CardInset" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{StaticResource BgRaised}" />
    </Style>

    <!-- Square icon button (38–42px, card surface) -->
    <Style x:Key="IconButtonFrame" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <!-- ═════════ Buttons ═════════ -->

    <!-- Primary go action (START, RESUME, Save): green fill, dark text -->
    <Style x:Key="GoButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Go}" />
        <Setter Property="TextColor" Value="{StaticResource OnGo}" />
        <Setter Property="FontFamily" Value="SpaceGroteskSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <!-- Accent action -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource OnAccent}" />
        <Setter Property="FontFamily" Value="SpaceGroteskSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- Quiet elevated button (PAUSE, secondary actions) -->
    <Style x:Key="ElevatedButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="SpaceGroteskSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderColor" Value="{StaticResource BorderDefault}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- Destructive outline (Delete board) -->
    <Style x:Key="DangerOutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderColor" Value="{StaticResource HoldBarBorder}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- Text-only link button -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
    </Style>
</ResourceDictionary>
