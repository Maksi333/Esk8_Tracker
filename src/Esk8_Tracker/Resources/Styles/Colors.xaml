<?xml version="1.0" encoding="UTF-8" ?>
<!-- ESK8 Tracker design tokens (dark-first telemetry instrument theme).
     Source of truth: design_handoff_esk8_tracker/README.md §Design Tokens. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Surfaces -->
    <Color x:Key="BgBase">#0B0E11</Color>
    <Color x:Key="BgRaised">#0F1318</Color>
    <Color x:Key="SurfaceCard">#151A1F</Color>
    <Color x:Key="SurfaceCard2">#12181E</Color>
    <Color x:Key="SurfaceElevated">#1E252B</Color>

    <!-- Borders -->
    <Color x:Key="BorderHairline">#1C242B</Color>
    <Color x:Key="BorderDefault">#2A333B</Color>
    <Color x:Key="BorderStrong">#3A4550</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#F2F5F7</Color>
    <Color x:Key="TextSecondary">#B9C4CC</Color>
    <Color x:Key="TextTertiary">#8A97A2</Color>
    <Color x:Key="TextFaint">#4A5560</Color>

    <!-- Brand / semantic -->
    <Color x:Key="Accent">#4C8DFF</Color>
    <Color x:Key="Go">#22C55E</Color>
    <Color x:Key="Warn">#F5C51E</Color>
    <Color x:Key="Danger">#F03E3E</Color>
    <Color x:Key="BoardPurple">#B47CFF</Color>

    <!-- Text on filled semantic buttons -->
    <Color x:Key="OnGo">#04160B</Color>
    <Color x:Key="OnAccent">#031428</Color>
    <Color x:Key="OnWarn">#160E00</Color>

    <!-- Faint fills (accent at 10–16% alpha) -->
    <Color x:Key="AccentFaint">#244C8DFF</Color>
    <Color x:Key="GoFaint">#2422C55E</Color>
    <Color x:Key="WarnFaint">#1AF5C51E</Color>
    <Color x:Key="DangerFaint">#1AF03E3E</Color>

    <!-- Hold-to-stop bar -->
    <Color x:Key="HoldBarBg">#1A1315</Color>
    <Color x:Key="HoldBarBorder">#3A2226</Color>

    <!-- Velocity ramp stops (0 / 0.40 / 0.72 / 1.00 of board top speed) -->
    <Color x:Key="RampCruise">#2E7CF6</Color>
    <Color x:Key="RampFlow">#22C55E</Color>
    <Color x:Key="RampPush">#F5C51E</Color>
    <Color x:Key="RampSend">#F03E3E</Color>

    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBase}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefault}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
</ResourceDictionary>
