<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Esk8_Tracker.ViewModels"
             xmlns:controls="clr-namespace:Esk8_Tracker.Controls"
             xmlns:icons="clr-namespace:Esk8_Tracker"
             x:Class="Esk8_Tracker.Views.RideSection"
             x:DataType="vm:RideViewModel"
             BackgroundColor="{StaticResource BgBase}">
    <Grid>

        <!-- ══════════ IDLE ══════════ -->
        <ScrollView IsVisible="{Binding IsIdle}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="18,16,18,20" RowSpacing="0">

                <!-- status row -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                        <Label Text="{Binding GpsIcon}" Style="{StaticResource Icon}" FontSize="17" TextColor="{Binding GpsColor}" />
                        <Label Text="{Binding GpsLabel}" FontFamily="InterMedium" FontSize="12.5" TextColor="{Binding GpsColor}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 100" BackgroundColor="{StaticResource SurfaceCard}"
                            Stroke="{StaticResource BorderDefault}" StrokeThickness="1" Padding="8,6,12,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenBoardSwitcherCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="7">
                            <Border WidthRequest="20" HeightRequest="20" StrokeThickness="0" BackgroundColor="{Binding ActiveBoardColor}"
                                    StrokeShape="RoundRectangle 6">
                                <Label Text="{x:Static icons:MaterialIcons.Skateboarding}" FontFamily="MaterialRounded" FontSize="14"
                                       TextColor="#04160B" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="{Binding ActiveBoardName}" FontFamily="InterMedium" FontSize="12.5" VerticalOptions="Center" />
                            <Label Text="{x:Static icons:MaterialIcons.ExpandMore}" FontFamily="MaterialRounded" FontSize="16" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- recovery banner -->
                <Border Grid.Row="1" IsVisible="{Binding ShowRecoveryBanner}" BackgroundColor="{StaticResource SurfaceElevated}"
                        Stroke="{StaticResource Warn}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="15,13" Margin="0,0,0,14">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                        <Label Text="{x:Static icons:MaterialIcons.Restore}" FontFamily="MaterialRounded" FontSize="22" TextColor="{StaticResource Warn}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Resume unsaved ride?" FontFamily="InterSemiBold" FontSize="13.5" />
                            <Label Text="{Binding RecoverySubtitle}" FontFamily="Inter" FontSize="11.5" TextColor="{StaticResource TextTertiary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="Resume" Command="{Binding ResumeRecoveredCommand}" BackgroundColor="{StaticResource Warn}"
                                TextColor="{StaticResource OnWarn}" FontFamily="InterSemiBold" FontSize="12.5" CornerRadius="9" Padding="13,8" HeightRequest="36" />
                        <Button Grid.Column="3" Text="{x:Static icons:MaterialIcons.Close}" Command="{Binding DismissRecoveryCommand}" FontFamily="MaterialRounded"
                                FontSize="20" BackgroundColor="Transparent" TextColor="{StaticResource TextTertiary}" Padding="4" WidthRequest="32" />
                    </Grid>
                </Border>

                <!-- permission banner -->
                <Border Grid.Row="2" IsVisible="{Binding ShowPermissionBanner}" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FixPermissionCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                        <Label Text="{x:Static icons:MaterialIcons.GppMaybe}" FontFamily="MaterialRounded" FontSize="20" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                        <Label Grid.Column="1" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Background tracking is limited. Rides may stop in your pocket. " />
                                    <Span Text="Fix →" TextColor="{StaticResource Accent}" FontFamily="InterSemiBold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>
                </Border>

                <!-- lifetime teaser -->
                <VerticalStackLayout Grid.Row="3" HorizontalOptions="Center" Spacing="6" Margin="0,6,0,2">
                    <Label Text="LIFETIME" Style="{StaticResource SectionLabel}" HorizontalOptions="Center" CharacterSpacing="1.4" />
                    <Label Text="{Binding LifetimeSummary}" FontFamily="ChakraPetch" FontSize="19" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- START button -->
                <Grid Grid.Row="4" HorizontalOptions="Center" VerticalOptions="Center" MinimumHeightRequest="230">
                    <Border WidthRequest="210" HeightRequest="210" StrokeThickness="0" StrokeShape="RoundRectangle 105"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.38" Radius="0.75">
                                <GradientStop Color="#2BE070" Offset="0.0" />
                                <GradientStop Color="#22C55E" Offset="0.55" />
                                <GradientStop Color="#15914A" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#22C55E" Opacity="0.35" Radius="60" Offset="0,0" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StartRideCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0"
                                             SemanticProperties.Description="Start ride">
                            <Label Text="{x:Static icons:MaterialIcons.PlayArrow}" FontFamily="MaterialRoundedFilled" FontSize="52"
                                   TextColor="#04160B" HorizontalTextAlignment="Center" />
                            <Label Text="START" FontFamily="SpaceGroteskBold" FontSize="20" CharacterSpacing="1.5" TextColor="#04160B" HorizontalTextAlignment="Center" />
                            <Label Text="RIDE" FontFamily="SpaceGroteskSemiBold" FontSize="13" CharacterSpacing="3" Opacity="0.7" TextColor="#04160B" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- last ride card -->
                <VerticalStackLayout Grid.Row="5" IsVisible="{Binding HasLastRide}" Spacing="8" Margin="0,6,0,0">
                    <Label Text="{Binding LastRideLabel}" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenLastRideCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <controls:SparkBarsView WidthRequest="64" HeightRequest="44" VerticalOptions="Center"
                                                    Samples="{Binding LastRideSamples}" TopSpeedMps="{Binding LastRideTop}" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding LastRideName}" FontFamily="InterSemiBold" FontSize="14" />
                                <Label Text="{Binding LastRideStat}" Style="{StaticResource NumericCaption}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{x:Static icons:MaterialIcons.ChevronRight}" FontFamily="MaterialRounded"
                                   FontSize="22" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!-- ══════════ ACTIVE ══════════ -->
        <Grid IsVisible="{Binding IsActive}" Padding="18,14,18,18" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding MarkInteractionCommand}" />
            </Grid.GestureRecognizers>

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleMapPeekCommand}" NumberOfTapsRequired="2" />
                </Grid.GestureRecognizers>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label x:Name="RecDot" Text="{x:Static icons:MaterialIcons.FiberManualRecord}" FontFamily="MaterialRounded" FontSize="17" TextColor="{StaticResource Go}" VerticalOptions="Center" />
                    <Label Text="{Binding ElapsedDisplay}" FontFamily="ChakraPetch" FontSize="15" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Label Text="{x:Static icons:MaterialIcons.GraphicEq}" FontFamily="MaterialRounded" FontSize="20" TextColor="{StaticResource Accent}" IsVisible="{Binding VoiceCuesOn}" VerticalOptions="Center" />
                    <Border Style="{StaticResource IconButtonFrame}" WidthRequest="38" HeightRequest="38">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleGlanceCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static icons:MaterialIcons.Lock}" FontFamily="MaterialRounded" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <Label Grid.Row="1" IsVisible="{Binding GpsLost}" Text="GPS weak — still recording" FontFamily="InterMedium"
                   FontSize="12" TextColor="{StaticResource Warn}" HorizontalOptions="Center" Margin="0,6,0,0" />

            <!-- speedometer hero -->
            <Grid Grid.Row="2" HorizontalOptions="Center" VerticalOptions="Center" MinimumHeightRequest="210">
                <controls:SpeedometerView WidthRequest="300" HeightRequest="210" Variant="arc"
                                          SpeedMps="{Binding CurrentSpeedMps}" TopSpeedMps="{Binding TopSpeedMps}" />
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" TranslationY="30" Spacing="0">
                    <Label Text="{Binding SpeedDisplay}" FontFamily="ChakraPetchBold" FontSize="96" CharacterSpacing="-2"
                           TextColor="{Binding SpeedColor}" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding SpeedUnit}" FontFamily="ChakraPetch" FontSize="16" CharacterSpacing="2"
                           TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- tiles -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" Margin="0,0,0,14">
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{x:Static icons:MaterialIcons.Straighten}" FontFamily="MaterialRounded" FontSize="14" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                            <Label Text="DISTANCE" Style="{StaticResource TileLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding DistanceDisplay}" Style="{StaticResource TileValue}" />
                            <Label Text="{Binding DistanceUnit}" FontSize="13" TextColor="{StaticResource TextTertiary}" VerticalOptions="End" Margin="0,0,0,2" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="14,12">
                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{x:Static icons:MaterialIcons.Bolt}" FontFamily="MaterialRounded" FontSize="14" TextColor="{StaticResource Danger}" VerticalOptions="Center" />
                            <Label Text="TOP SPEED" Style="{StaticResource TileLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding TileTopValue}" Style="{StaticResource TileValue}" TextColor="{Binding TileTopColor}" />
                            <Label Text="{Binding SpeedUnit}" FontSize="13" TextColor="{StaticResource TextTertiary}" VerticalOptions="End" Margin="0,0,0,2" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{Binding TileFourthIcon}" FontFamily="MaterialRounded" FontSize="14" TextColor="{Binding TileFourthIconColor}" VerticalOptions="Center" />
                            <Label Text="{Binding TileFourthLabel}" Style="{StaticResource TileLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding TileFourthValue}" Style="{StaticResource TileValue}" />
                            <Label Text="{Binding TileFourthUnit}" FontSize="13" TextColor="{StaticResource TextTertiary}" VerticalOptions="End" Margin="0,0,0,2" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14,12">
                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{x:Static icons:MaterialIcons.Speed}" FontFamily="MaterialRounded" FontSize="14" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                            <Label Text="AVG SPEED" Style="{StaticResource TileLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding TileAvgValue}" Style="{StaticResource TileValue}" />
                            <Label Text="{Binding SpeedUnit}" FontSize="13" TextColor="{StaticResource TextTertiary}" VerticalOptions="End" Margin="0,0,0,2" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- controls -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
                <Border HeightRequest="60" BackgroundColor="{StaticResource SurfaceElevated}"
                        Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PauseCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                        <Label Text="{x:Static icons:MaterialIcons.Pause}" FontFamily="MaterialRounded" FontSize="22" VerticalOptions="Center" />
                        <Label Text="PAUSE" FontFamily="SpaceGroteskSemiBold" FontSize="16" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Border Grid.Column="1" WidthRequest="88" HeightRequest="60"
                        BackgroundColor="{StaticResource SurfaceElevated}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleMapPeekCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                        <Label Text="{x:Static icons:MaterialIcons.Map}" FontFamily="MaterialRounded" FontSize="22" HorizontalTextAlignment="Center" />
                        <Label Text="MAP" FontFamily="InterSemiBold" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <controls:HoldToStopBar x:Name="ActiveHoldBar" Grid.Row="5" />
        </Grid>

        <!-- ══════════ PAUSED ══════════ -->
        <Grid IsVisible="{Binding IsPaused}" Padding="18,14,18,18" RowDefinitions="*,Auto,Auto">
            <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label x:Name="PauseIcon" Text="{x:Static icons:MaterialIcons.PauseCircle}" FontFamily="MaterialRounded" FontSize="58" TextColor="{StaticResource Warn}" HorizontalTextAlignment="Center" />
                <Label Text="PAUSED" FontFamily="SpaceGroteskBold" FontSize="34" CharacterSpacing="2" HorizontalTextAlignment="Center" />
                <Label Text="{Binding PauseReason}" FontSize="13" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="2" Margin="0,14,0,0">
                    <Label Text="{Binding SpeedDisplay}" FontFamily="ChakraPetchSemiBold" FontSize="74" TextColor="{StaticResource TextFaint}" />
                    <Label Text="{Binding SpeedUnit}" FontFamily="ChakraPetch" FontSize="24" TextColor="{StaticResource TextFaint}" VerticalOptions="Center" Margin="6,10,0,0" />
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="26" Margin="0,20,0,0">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding DistanceDisplay}" FontFamily="ChakraPetch" FontSize="24" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding DistanceUnit, StringFormat='{0} · held'}" FontSize="11" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="{Binding ElapsedDisplay}" FontFamily="ChakraPetch" FontSize="24" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        <Label Text="moving · held" FontSize="11" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Border Grid.Row="1" BackgroundColor="{StaticResource Go}" StrokeThickness="0" StrokeShape="RoundRectangle 18" HeightRequest="66" Margin="0,0,0,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ResumeCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="9">
                    <Label Text="{x:Static icons:MaterialIcons.PlayArrow}" FontFamily="MaterialRoundedFilled" FontSize="26" TextColor="{StaticResource OnGo}" VerticalOptions="Center" />
                    <Label Text="RESUME" FontFamily="SpaceGroteskBold" FontSize="19" CharacterSpacing="1" TextColor="{StaticResource OnGo}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <controls:HoldToStopBar x:Name="PausedHoldBar" Grid.Row="2" />
        </Grid>

        <!-- ══════════ SUMMARY ══════════ -->
        <Grid IsVisible="{Binding IsSummary}" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="18,14">
                <HorizontalStackLayout Spacing="5" HorizontalOptions="Start">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DiscardRideCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="{x:Static icons:MaterialIcons.Close}" FontFamily="MaterialRounded" FontSize="22" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                    <Label Text="Discard" FontSize="13" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border Grid.Column="1" BackgroundColor="{StaticResource Go}" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="18,9">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveRideCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{x:Static icons:MaterialIcons.Check}" FontFamily="MaterialRounded" FontSize="19" TextColor="{StaticResource OnGo}" VerticalOptions="Center" />
                        <Label Text="Save" FontFamily="SpaceGroteskBold" FontSize="14" TextColor="{StaticResource OnGo}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="18,0,18,24" Spacing="0">
                    <!-- route hero -->
                    <Border IsVisible="{Binding SummaryHasRoute}" StrokeShape="RoundRectangle 16" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" HeightRequest="280" Padding="0">
                        <controls:RouteFieldView Samples="{Binding SummarySamples}" TopSpeedMps="{Binding TopSpeedMps}" ShowHeadDot="False" />
                    </Border>
                    <Border IsVisible="{Binding SummaryHasRoute, Converter={StaticResource InvertedBoolConverter}}" Style="{StaticResource CardInset}" HeightRequest="120" StrokeShape="RoundRectangle 16">
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Label Text="{x:Static icons:MaterialIcons.GppMaybe}" FontFamily="MaterialRounded" FontSize="22" TextColor="{StaticResource TextTertiary}" />
                            <Label Text="No route recorded — stats only" FontSize="13" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- short-ride banner -->
                    <Border IsVisible="{Binding ShowShortRideBanner}" Style="{StaticResource CardQuiet}" Margin="0,10,0,0" Padding="14,10" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Very short ride" FontSize="12.5" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Discard" Command="{Binding DiscardRideCommand}" Style="{StaticResource TextButton}" TextColor="{StaticResource Danger}" FontSize="12.5" />
                        </Grid>
                    </Border>

                    <!-- name -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,4">
                        <Entry Text="{Binding RideName}" FontFamily="SpaceGroteskSemiBold" FontSize="22" />
                        <Label Grid.Column="1" Text="{x:Static icons:MaterialIcons.Edit}" FontFamily="MaterialRounded" FontSize="18" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                    </Grid>

                    <!-- board + tag chips -->
                    <FlexLayout Wrap="Wrap" Margin="0,0,0,6" BindableLayout.ItemsSource="{Binding SummaryTags}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagChip">
                                <Border StrokeShape="RoundRectangle 100" Margin="0,0,8,8" Padding="11,5"
                                        BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTagTapped" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="{x:Static icons:MaterialIcons.Sell}" FontFamily="MaterialRounded" FontSize="14" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                                        <Label Text="{Binding Name}" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Border IsVisible="{Binding SummaryHasBoard}" StrokeShape="RoundRectangle 100" Padding="11,5" HorizontalOptions="Start"
                            BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" Margin="0,0,0,4">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="2" Color="{Binding SummaryBoardColor}" VerticalOptions="Center" />
                            <Label Text="{Binding SummaryBoardName}" FontSize="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- stats row -->
                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,16,0,0">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding SummaryDistance}" FontFamily="ChakraPetchSemiBold" FontSize="24" HorizontalTextAlignment="Center" />
                            <Label Text="distance" FontSize="11" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="{Binding SummaryMoving}" FontFamily="ChakraPetchSemiBold" FontSize="24" HorizontalTextAlignment="Center" />
                            <Label Text="moving" FontSize="11" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="{Binding SummaryAvg}" FontFamily="ChakraPetchSemiBold" FontSize="24" HorizontalTextAlignment="Center" />
                            <Label Text="avg" FontSize="11" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center">
                            <Label Text="{Binding SummaryTop}" FontFamily="ChakraPetchSemiBold" FontSize="24" TextColor="{Binding SummaryTopColor}" HorizontalTextAlignment="Center" />
                            <Label Text="top" FontSize="11" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- speed graph -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,8" IsVisible="{Binding SummaryHasRoute}">
                        <Label Text="Speed over distance" FontSize="12" TextColor="{StaticResource TextTertiary}" />
                        <Label Grid.Column="1" Text="{Binding SummaryDistance}" FontFamily="ChakraPetch" FontSize="12" TextColor="{StaticResource TextTertiary}" />
                    </Grid>
                    <Border IsVisible="{Binding SummaryHasRoute}" Style="{StaticResource CardInset}" HeightRequest="130" StrokeShape="RoundRectangle 14" Padding="8">
                        <controls:SpeedGraphView Samples="{Binding SummarySamples}" TopSpeedMps="{Binding TopSpeedMps}" />
                    </Border>

                    <!-- PR callout -->
                    <Border IsVisible="{Binding ShowPrCallout}" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource WarnFaint}"
                            Stroke="{StaticResource Warn}" StrokeThickness="1" Padding="15,13" Margin="0,14,0,0">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="{x:Static icons:MaterialIcons.EmojiEvents}" FontFamily="MaterialRounded" FontSize="24" TextColor="{StaticResource Warn}" VerticalOptions="Center" />
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="New top speed!" FontFamily="InterSemiBold" FontSize="14" TextColor="{StaticResource Warn}" />
                                <Label Text="{Binding PrText}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- notes -->
                    <Border Style="{StaticResource CardQuiet}" Margin="0,12,0,0" Padding="14,12" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                            <Label Text="{x:Static icons:MaterialIcons.Cloud}" FontFamily="MaterialRounded" FontSize="18" TextColor="{StaticResource TextTertiary}" VerticalOptions="Start" Margin="0,4,0,0" />
                            <Editor Grid.Column="1" Text="{Binding RideNotes}" Placeholder="Add notes…" FontSize="13" AutoSize="TextChanges" />
                        </Grid>
                    </Border>

                    <!-- photo + share -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,14,0,0">
                        <Border BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddPhotoCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="7">
                                <Label Text="{x:Static icons:MaterialIcons.AddAPhoto}" FontFamily="MaterialRounded" FontSize="19" VerticalOptions="Center" />
                                <Label Text="Photo" FontFamily="InterSemiBold" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShareRideCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="7">
                                <Label Text="{x:Static icons:MaterialIcons.IosShare}" FontFamily="MaterialRounded" FontSize="19" VerticalOptions="Center" />
                                <Label Text="Share" FontFamily="InterSemiBold" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ══════════ GLANCE OVERLAY ══════════ -->
        <Grid IsVisible="{Binding GlanceMode}" BackgroundColor="Black">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ExitGlanceCommand}" />
            </Grid.GestureRecognizers>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <Label Text="{Binding SpeedDisplay}" FontFamily="ChakraPetchBold" FontSize="170" TextColor="{Binding SpeedColor}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding SpeedUnit}" FontFamily="ChakraPetch" FontSize="26" CharacterSpacing="2" TextColor="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,26,0,0">
                    <Label Text="{Binding DistanceDisplay}" FontFamily="ChakraPetch" FontSize="34" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding DistanceUnit}" FontFamily="ChakraPetch" FontSize="22" TextColor="{StaticResource TextTertiary}" VerticalOptions="End" Margin="0,0,0,4" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,26" Spacing="6">
                <Label Text="{x:Static icons:MaterialIcons.TouchApp}" FontFamily="MaterialRounded" FontSize="16" TextColor="{StaticResource TextFaint}" VerticalOptions="Center" />
                <Label Text="Tap to exit glance mode" FontSize="12" TextColor="{StaticResource TextFaint}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>

        <!-- ══════════ MAP PEEK OVERLAY ══════════ -->
        <Grid IsVisible="{Binding MapPeek}" BackgroundColor="#CC030507" Padding="20">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMapPeekCommand}" />
            </Grid.GestureRecognizers>
            <Border VerticalOptions="Center" BackgroundColor="{StaticResource BgRaised}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="0">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                        <Label Text="Live route" FontFamily="SpaceGroteskSemiBold" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{x:Static icons:MaterialIcons.Close}" FontFamily="MaterialRounded" FontSize="24" TextColor="{StaticResource TextTertiary}" />
                    </Grid>
                    <controls:RouteFieldView HeightRequest="340" Samples="{Binding LiveSamplesSnapshot}" TopSpeedMps="{Binding TopSpeedMps}" ShowHeadDot="True" />
                    <controls:RampLegendView HeightRequest="34" Margin="16,12" TopSpeedMps="{Binding TopSpeedMps}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
