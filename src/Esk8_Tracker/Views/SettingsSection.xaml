<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Esk8_Tracker.ViewModels"
             xmlns:views="clr-namespace:Esk8_Tracker.Views"
             xmlns:icons="clr-namespace:Esk8_Tracker"
             x:Class="Esk8_Tracker.Views.SettingsSection"
             x:DataType="vm:SettingsViewModel"
             BackgroundColor="{StaticResource BgBase}">
    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,24" Spacing="0">
            <Label Text="Settings" Style="{StaticResource ScreenTitle}" Margin="0,0,0,18" />

            <!-- units -->
            <Label Text="UNITS" Style="{StaticResource SectionLabel}" Margin="0,0,0,9" />
            <Border BackgroundColor="{StaticResource SurfaceCard}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="4" Margin="0,0,0,22">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="0">
                    <Border BackgroundColor="{Binding Metric, Converter={StaticResource UnitSelBgConverter}}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="0,10">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetMetricCommand}" /></Border.GestureRecognizers>
                        <Label Text="Metric (km)" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" TextColor="{Binding Metric, Converter={StaticResource UnitSelTextConverter}}" />
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{Binding Imperial, Converter={StaticResource UnitSelBgConverter}}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="0,10">
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetImperialCommand}" /></Border.GestureRecognizers>
                        <Label Text="Imperial (mi)" FontFamily="InterSemiBold" FontSize="13" HorizontalTextAlignment="Center" TextColor="{Binding Imperial, Converter={StaticResource UnitSelTextConverter}}" />
                    </Border>
                </Grid>
            </Border>

            <!-- auto-pause -->
            <Label Text="AUTO-PAUSE SENSITIVITY" Style="{StaticResource SectionLabel}" Margin="0,0,0,9" />
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6" Margin="0,0,0,22">
                <Border BackgroundColor="{Binding AutoOff, Converter={StaticResource SegBgConverter}}" Stroke="{Binding AutoOff, Converter={StaticResource AutoBorderConverter}}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="0,10">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetAutoPauseCommand}" CommandParameter="Off" /></Border.GestureRecognizers>
                    <Label Text="Off" FontFamily="InterSemiBold" FontSize="12.5" HorizontalTextAlignment="Center" TextColor="{Binding AutoOff, Converter={StaticResource AccentTextConverter}}" />
                </Border>
                <Border Grid.Column="1" BackgroundColor="{Binding AutoLow, Converter={StaticResource SegBgConverter}}" Stroke="{Binding AutoLow, Converter={StaticResource AutoBorderConverter}}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="0,10">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetAutoPauseCommand}" CommandParameter="Low" /></Border.GestureRecognizers>
                    <Label Text="Low" FontFamily="InterSemiBold" FontSize="12.5" HorizontalTextAlignment="Center" TextColor="{Binding AutoLow, Converter={StaticResource AccentTextConverter}}" />
                </Border>
                <Border Grid.Column="2" BackgroundColor="{Binding AutoNormal, Converter={StaticResource SegBgConverter}}" Stroke="{Binding AutoNormal, Converter={StaticResource AutoBorderConverter}}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="0,10">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetAutoPauseCommand}" CommandParameter="Normal" /></Border.GestureRecognizers>
                    <Label Text="Normal" FontFamily="InterSemiBold" FontSize="12.5" HorizontalTextAlignment="Center" TextColor="{Binding AutoNormal, Converter={StaticResource AccentTextConverter}}" />
                </Border>
                <Border Grid.Column="3" BackgroundColor="{Binding AutoHigh, Converter={StaticResource SegBgConverter}}" Stroke="{Binding AutoHigh, Converter={StaticResource AutoBorderConverter}}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="0,10">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SetAutoPauseCommand}" CommandParameter="High" /></Border.GestureRecognizers>
                    <Label Text="High" FontFamily="InterSemiBold" FontSize="12.5" HorizontalTextAlignment="Center" TextColor="{Binding AutoHigh, Converter={StaticResource AccentTextConverter}}" />
                </Border>
            </Grid>

            <!-- live dashboard & cues -->
            <Label Text="LIVE DASHBOARD &amp; CUES" Style="{StaticResource SectionLabel}" Margin="0,0,0,9" />
            <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 14" Padding="0" Margin="0,0,0,22">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="15,14" ColumnSpacing="13">
                        <Label Text="{x:Static icons:MaterialIcons.GraphicEq}" FontFamily="MaterialRounded" FontSize="21" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Voice cues" FontSize="14" FontFamily="InterMedium" />
                            <Label Text="Announce stats every 2 km to earbuds" FontSize="11.5" TextColor="{StaticResource TextTertiary}" />
                        </VerticalStackLayout>
                        <views:PillToggle Grid.Column="2" x:Name="VoiceToggle" IsOn="{Binding VoiceCues}" Description="Voice cues" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Color="{StaticResource BorderDefault}" HeightRequest="1" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="15,14" ColumnSpacing="13">
                        <Label Text="{x:Static icons:MaterialIcons.Lock}" FontFamily="MaterialRounded" FontSize="21" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Auto glance-mode" FontSize="14" FontFamily="InterMedium" />
                            <Label Text="Dim to speed-only after 30s" FontSize="11.5" TextColor="{StaticResource TextTertiary}" />
                        </VerticalStackLayout>
                        <views:PillToggle Grid.Column="2" x:Name="GlanceToggle" IsOn="{Binding AutoGlance}" Description="Auto glance mode" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Color="{StaticResource BorderDefault}" HeightRequest="1" />
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="15,14" ColumnSpacing="13">
                        <Label Text="{x:Static icons:MaterialIcons.Palette}" FontFamily="MaterialRounded" FontSize="21" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Always colorize map" FontSize="14" FontFamily="InterMedium" />
                            <Label Text="Route always drawn on velocity ramp" FontSize="11.5" TextColor="{StaticResource TextTertiary}" />
                        </VerticalStackLayout>
                        <views:PillToggle Grid.Column="2" x:Name="ColorizeToggle" IsOn="{Binding ColorizeMap}" Description="Colorize map" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- data -->
            <Label Text="YOUR DATA · LOCAL-FIRST" Style="{StaticResource SectionLabel}" Margin="0,0,0,9" />
            <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 14" Padding="0" Margin="0,0,0,22">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="15,14" ColumnSpacing="13">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ExportCommand}" /></Grid.GestureRecognizers>
                        <Label Text="{x:Static icons:MaterialIcons.Download}" FontFamily="MaterialRounded" FontSize="21" TextColor="{StaticResource Accent}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Export all rides" FontSize="14" FontFamily="InterMedium" />
                            <Label Text="GPX / JSON · your backup" FontSize="11.5" TextColor="{StaticResource TextTertiary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="{x:Static icons:MaterialIcons.ChevronRight}" FontFamily="MaterialRounded" FontSize="20" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Color="{StaticResource BorderDefault}" HeightRequest="1" />
                    <Grid ColumnDefinitions="Auto,*" Padding="15,14" ColumnSpacing="13">
                        <Label Text="{x:Static icons:MaterialIcons.SdStorage}" FontFamily="MaterialRounded" FontSize="21" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Storage used" FontSize="14" FontFamily="InterMedium" />
                            <Label Text="{Binding StorageText}" FontSize="11.5" TextColor="{StaticResource TextTertiary}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- reassurance -->
            <Border Style="{StaticResource CardQuiet}" StrokeShape="RoundRectangle 14" Padding="15" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{x:Static icons:MaterialIcons.Lock}" FontFamily="MaterialRounded" FontSize="24" TextColor="{StaticResource Go}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Everything stays on your device. No account, no server, works fully offline." FontSize="12.5" TextColor="{StaticResource TextSecondary}" LineHeight="1.45" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="{Binding Version}" FontFamily="ChakraPetch" FontSize="11.5" TextColor="{StaticResource TextFaint}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
